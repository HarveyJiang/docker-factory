# syntax=docker/dockerfile:1.6
# DeepSeek Harness - Everything is a Plugin
# 上游: https://github.com/deepseek-ai/deepseek-harness (pnpm + Node22/24)
# 构建: pnpm install + pnpm run build, 运行: npx dsh web / dsh

# ---------- builder ----------
FROM node:24-bookworm AS builder
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate \
  && node --version && pnpm --version

WORKDIR /app

# 1. 依赖清单（利用层缓存）
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY patches ./patches
COPY vendor ./vendor
COPY packages ./packages
COPY apps ./apps
COPY native ./native
COPY python ./python
COPY scripts ./scripts
COPY tsconfig.*.json vitest*.config.ts tsdown.config.ts knip.json lefthook.yml .oxlintrc.json ./
# 也可只 COPY package.json 再 pnpm install，但 harness 依赖 workspace 需全量
COPY . .

# 2. 安装 + 构建（复用 BuildKit cache）
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile \
 && pnpm run build

# ---------- runtime ----------
FROM node:24-bookworm-slim AS runtime
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate
# Python (harness 有 python sdk) + 常用工具
RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates \
  curl \
  git \
  python3 \
  python3-pip \
  tzdata \
  bash \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app ./

# 环境变量
ENV TZ=Asia/Shanghai
ENV NODE_ENV=production
EXPOSE 3000

# 默认启动 dsh web (harness 官方: npx @deepseek-ai/dsh web)
# 可通过 docker run 时覆盖: docker run ghcr.io/harveyjiang/deepseek-harness dsh --help
ENTRYPOINT ["pnpm", "dsh"]
CMD ["web", "--help"]
