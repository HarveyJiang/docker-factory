# OpenChamber 环境变量示例
# 复制: cp .env.example .env && vim .env && docker compose up -d

# 必填：UI 密码（Docker 暴露到 0.0.0.0 时必须）
# 生成: openssl rand -base64 24
OPENCHAMBER_UI_PASSWORD=change_me_to_random_24_chars

# 选填：绑定地址（默认 0.0.0.0）
# OPENCHAMBER_HOST=0.0.0.0

# 选填：隧道
# OPENCHAMBER_TUNNEL_PROVIDER=cloudflare
# OPENCHAMBER_TUNNEL_MODE=quick
# OPENCHAMBER_TUNNEL_HOSTNAME=app.example.com
# OPENCHAMBER_TUNNEL_TOKEN=your_cf_token

# 选填：oh-my-opencode
# OH_MY_OPENCODE=true

# 选填：外置 OpenCode
# OPENCODE_HOST=http://172.17.0.1:4096
# OPENCODE_SKIP_START=true
