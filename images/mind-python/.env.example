# 复制为 .env 并根据实际生产环境修改配置
# 参考上游 mind-python/.env.sample

ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG_MODE=false

# API Token 鉴权（启用后白名单外除 /healthz 外都需要 Token）
AUTH_ENABLED=false
API_KEY=
# 免 Token 白名单，逗号或分号分隔的 IPv4/IPv6 及 CIDR
AUTH_WHITELIST_IPS=

APP_NAME=Mind Python API Service

# 若未启用对应组件，留空或保持默认会自动优雅降级
REDIS_URL=redis://localhost:6379/0
MYSQL_URL=mysql+asyncmy://root:password@localhost:3306/mind_db
MONGODB_URL=mongodb://root:password@localhost:27017/
